---
// The home page of the help center: the three parts by who is reading (an icon, a title, one line and a button to its first page),
// then where to write.
import { sections } from '../lib/sections';
import { useT } from '../i18n';
import { pageHref } from '../lib/links';

const locale = Astro.locals.starlightRoute?.locale;
const t = useT(locale);

// A question mark in a circle, for the card that is not a part of the help center.
const help = 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-1.8-12.2a2.2 2.2 0 1 1 3.3 1.9c-.9.5-1.5 1-1.5 2m0 2.8v.1';

const topics = Object.entries(sections).map(([key, section]) => ({
  href: pageHref(section.page, locale),
  icon: section.icon,
  title: t.sections[key as keyof typeof t.sections].title,
  text: t.sections[key as keyof typeof t.sections].text,
}));
---

<div class="home not-content">
  <section class="hero" aria-labelledby="home-title">
    <h1 id="home-title">{t.home.title}</h1>
    <p class="subtitle">{t.home.subtitle}</p>
  </section>

  <section aria-labelledby="home-sections">
    <h2 id="home-sections" class="sr-only">{t.home.topics}</h2>
    <ul class="cards">
      {
        topics.map((s) => (
          <li>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon} /></svg>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a class="button" href={s.href}>{t.home.start}</a>
          </li>
        ))
      }
      <li>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={help} /></svg>
        <h3>{t.home.contact.title}</h3>
        <p>{t.home.contact.text}</p>
        <a class="button secondary" href={`mailto:${t.home.contact.address}`}>{t.home.contact.button}</a>
      </li>
    </ul>
  </section>
</div>

<style>
  .home { display: grid; gap: 2rem; padding-block: 1rem 3rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  h1 { font-size: var(--sl-text-4xl); line-height: 1.15; font-weight: 700; letter-spacing: -0.015em; color: var(--sl-color-white); }
  .subtitle { margin: 0.75rem 0 0; max-width: 42rem; font-size: var(--sl-text-lg); color: var(--sl-color-gray-2); }

  /* A card is a row: a ringed icon on the left, the words and the button on the right. */
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cards > li { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto 1fr auto; column-gap: 1.25rem; align-items: start; margin: 0; padding: 1.5rem 1.75rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.75rem; }
  .icon { grid-row: 1 / span 3; box-sizing: content-box; width: 1.5rem; height: 1.5rem; padding: 0.7rem; border: 1px solid var(--sl-color-text-accent); border-radius: 50%; fill: none; stroke: var(--sl-color-text-accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .cards h3 { margin: 0; font-size: var(--sl-text-xl); font-weight: 600; color: var(--sl-color-white); }
  .cards p { margin: 0.35rem 0 0; font-size: var(--sl-text-sm); line-height: 1.6; color: var(--sl-color-gray-2); }
  .button {
    justify-self: start; align-self: end; margin-top: 1rem; padding: 0.45rem 1rem; border-radius: 0.4rem; background: var(--sl-color-accent-high); color: var(--sl-color-black);
    font-size: var(--sl-text-sm); font-weight: 600; text-decoration: none;
  }
  .button.secondary { background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  .button:hover { opacity: 0.88; }
  .button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  @media (max-width: 40rem) {
    .cards { grid-template-columns: 1fr; }
    .cards > li { padding: 1.25rem; column-gap: 1rem; }
  }
</style>
